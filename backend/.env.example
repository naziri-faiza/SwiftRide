# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# JWT Authentication Secret
JWT_SECRET=replace_with_your_own_secret0ae97911b102f3e99a75d13c4dbc87e55467d9093c987a0acae30eaecaff11dc

# Razorpay Test Mode Credentials
# Get these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_yourKeyHere
RAZORPAY_KEY_SECRET=yourSecretKeyHere

# Supabase PostgreSQL Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
# Use service_role key on the backend for privileged DB operations (Never expose on frontend)
SUPABASE_SERVICE_ROLE_KEY=yourServiceRoleKeyHere                  
# Public anon key (fallback)                     
SUPABASE_ANON_KEY=yourAnonKeyHere
